│   │                      # - ローディング状態、空状態
│   ├── CaseCard.tsx       # 事例カード（151行）
│   │                      # - 関連度スコア、ハイライト表示
│   │                      # - メタ情報、タグ表示
│   ├── CaseDetail.tsx     # 事例詳細モーダル（249行）
│   │                      # - 構造化表示、関連事例推薦
│   │                      # - ESCキー、背景クリック対応
│   └── CaseCollector.tsx  # AI事例収集チャット（199行）
│                          # - Gemini API統合
│                          # - リアルタイムメッセージング
├── types/case.ts          # TypeScript型定義（83行）
│                          # - Case, SearchFilters, SearchResult
│                          # - 定数定義（INDUSTRIES, REGIONS等）
├── data/mockCases.ts      # 18件の建設業界事例（238行）
├── utils/search.ts        # 検索アルゴリズム（384行）
│                          # - 文字列類似度、関連度計算
│                          # - フィルタリング、関連事例推薦
└── services/
    └── geminiService.ts   # Gemini API統合（217行）
                          # - 対話管理、プロンプト制御
                          # - 事例構造化、エラーハンドリング
```

## データ構造・コンテンツ

### 事例データモデル（Case型）
```typescript
interface Case {
  id: string;                                    // 一意識別子
  title: string;                                 // 事例タイトル
  industry: '建設業' | '土木業' | '電気工事業' | ... // 業界（10種類）
  region: '北海道' | '東北' | '関東' | ...         // 地域（8地域）
  companySize: 'small' | 'medium' | 'large';      // 企業規模
  challenge: string;                             // 課題詳細
  proposal: string;                              // 提案内容
  result: string;                                // 成果・効果
  tags: string[];                                // タグ（15種類）
  createdAt: Date;                               // 作成日時
  updatedAt: Date;                               // 更新日時
}
```

### 収録事例カテゴリ（18件）
- **工期短縮・効率化**：マンション建設20%短縮、測量作業80%削減等
- **人材・働き方改革**：若手定着率40%改善、リモートワーク導入等
- **安全・品質管理**：IoT安全管理、労働災害ゼロ達成等
- **DX・AI活用**：BIM導入、AI画像認識、ドローン活用等
- **コスト・業務改善**：ペーパーレス化、在庫最適化等

## 検索アルゴリズム詳細

### 関連度スコアリング方式
```typescript
// フィールド別重み付きスコア計算
titleScore = calculateSubstringScore(title, query) * 3.0;
challengeScore = calculateSubstringScore(challenge, query) * 2.0;
proposalScore = calculateSubstringScore(proposal, query) * 1.5;
resultScore = calculateSubstringScore(result, query) * 1.5;
tagScore = calculateSubstringScore(tags, query) * 1.0;
industryScore = calculateSubstringScore(industry, query) * 0.5;

// 最終スコア（0-1の範囲に正規化）
finalScore = Math.min(totalScore / 10, 1.0);
```

### 文字列類似度計算
- **レーベンシュタイン距離**による編集距離計算
- **部分文字列マッチング**（完全一致、部分一致、単語一致）
- **ファジーマッチング**（0.4倍重み）
- **閾値フィルタリング**（関連度0.1未満を除外）

